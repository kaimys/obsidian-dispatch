{
	"name": "obsidian-dispatch",
	"version": "0.2.2",
	"description": "Property-driven kanban board with drag & drop, plus chip buttons that dispatch prompts to AI coding agents like Claude Code or Codex.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"install:docs": "node -e \"for (const f of ['main.js','manifest.json','styles.css']) require('fs').copyFileSync(f, 'docs/.obsidian/plugins/dispatch/' + f)\"",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"kanban",
		"ai",
		"claude-code"
	],
	"author": "Kai Mysliwiec",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.14.0",
		"esbuild": "^0.24.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"tslib": "^2.6.0",
		"typescript": "^5.5.0",
		"vitest": "^4.1.11",
		"yaml": "^2.9.0"
	}
}
